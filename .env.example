# 本地服务监听地址
HOST=127.0.0.1

# 本地服务监听端口
PORT=3000

# 调用本地桥接服务时使用的访问令牌，对应请求头 x-api-key
APP_TOKEN=change-me

# 目标 SkyMail 站点根地址，例如 https://mail.example.com
SKYMAIL_BASE_URL=https://your-skymail.example.com

# 用于登录目标 SkyMail 站点的邮箱账号
SKYMAIL_EMAIL=your-login@example.com

# 用于登录目标 SkyMail 站点的密码
SKYMAIL_PASSWORD=your-password

# 优先使用的域名池，支持多个域名用逗号分隔；留空则从上游可用域名中随机选择
PREFERRED_DOMAINS=example.com,example.org

# 随机邮箱前缀长度，例如生成 abc123@example.com 中的 abc123
RANDOM_LOCAL_LENGTH=10

# 长轮询默认轮询间隔，单位毫秒
DEFAULT_POLL_MS=3000

# 长轮询默认等待超时，单位毫秒
DEFAULT_WAIT_TIMEOUT_MS=30000

# 请求上游 SkyMail 站点时的超时时间，单位秒
REQUEST_TIMEOUT_SEC=30

# 域名连续失败达到该次数后，标记为不可用
DOMAIN_FAILURE_THRESHOLD=3
